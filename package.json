{
  "name": "magic-crm-demo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "local": "bun scripts/local-demo.mjs",
    "local:setup": "bun scripts/local-demo.mjs --setup-only",
    "local:check": "bun scripts/local-demo.mjs --check",
    "dev": "next dev --experimental-https --experimental-https-key .cert/localhost-key.pem --experimental-https-cert .cert/localhost.pem",
    "dev:http": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "public:check": "bash scripts/public-check.sh",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_PATH=./data/test.sqlite node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "db:init": "tsx scripts/init-db.ts",
    "db:reset": "tsx scripts/init-db.ts --reset"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "11.10.0",
    "next": "16.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
