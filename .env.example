# 浏览器和 MCP 客户端访问本服务的公开根地址，不包含末尾斜杠。
# 本机演示： http://localhost:3000
# 豆包工作： https://<your-cloudflared-domain>
APP_BASE_URL=http://localhost:3000

# 可选：浏览器跨域调用 MCP 时允许的 Origin，逗号分隔，禁止使用 *。
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 可选：SQLite 文件位置，默认 ./data/crm.sqlite
DATABASE_PATH=./data/crm.sqlite
