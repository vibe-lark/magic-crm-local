# 浏览器和 MCP 客户端访问本服务的公开根地址，不包含末尾斜杠。
# 本机演示与豆包本地注入：https://localhost:3000
APP_BASE_URL=https://localhost:3000

# 飞书开放平台应用凭证。把下方 callback 精确登记为“重定向 URL”。
LARK_APP_ID=
LARK_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=https://localhost:3000/oauth/feishu/callback

# 可选：浏览器跨域调用 MCP 时允许的 Origin，逗号分隔，禁止使用 *。
MCP_ALLOWED_ORIGINS=https://localhost:3000,https://127.0.0.1:3000

# 可选：SQLite 文件位置，默认 ./data/crm.sqlite
DATABASE_PATH=./data/crm.sqlite

# 可选：启用本地 OAuth 诊断事件（不记录 code、Token、PKCE 或密钥）。
OAUTH_DEBUG=false
OAUTH_DEBUG_PATH=./data/oauth-debug.ndjson
